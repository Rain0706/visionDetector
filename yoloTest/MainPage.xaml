<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="yoloTest.MainPage">
    <Grid>
        <ContentView x:Name="CameraContainer" 
                     HorizontalOptions="Fill" 
                     VerticalOptions="Fill" />

        <GraphicsView x:Name="BoundingBoxCanvas"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      InputTransparent="True" />

        <VerticalStackLayout VerticalOptions="End" 
                             Padding="20" 
                             Spacing="15">
            <Label x:Name="ResultLabel" Text="Be all set" BackgroundColor="#99000000" TextColor="White" FontSize="18" Padding="10" HorizontalTextAlignment="Center" />
            <Button x:Name="StartButton" Text="Start Identifying" Clicked="OnStartDetectionClicked" BackgroundColor="#007AFF" TextColor="White" FontAttributes="Bold" />
        </VerticalStackLayout>
    </Grid>



